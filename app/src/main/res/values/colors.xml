        <item>#9b94d1</item>
        <item>#69a9d1</item>
        <item>#a8c4d5</item>
        <item>#5ec7b7</item>
        <item>#97c9c1</item>
        <item>#72bb75</item>
        <item>#9db99f</item>
        <item>#c3d261</item>
        <item>#c6cd97</item>
        <item>#e6c04c</item>
        <item>#e7d292</item>
        <item>#e6984c</item>
        <item>#dfb286</item>
    </string-array>

</resources>
