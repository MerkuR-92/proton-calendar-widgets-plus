    <style name="TextviewStyle" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">100dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">#86AD33</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20dp</item>
    </style>

    <style name="ButtonStyle" parent="@android:style/Widget.Button">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">100dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">#F1511B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15dp</item>
    </style>


    <style name="AppFullscreenDialogTheme" parent="AppTheme">
        <item name="android:windowEnterAnimation">@anim/fragment_fade_enter</item>
        <item name="android:windowExitAnimation">@anim/fragment_fade_exit</item>
    </style>

    <style name="AppFormTextHeader" parent="@android:style/TextAppearance"></style>

    <style name="AppFormTextContent" parent="@android:style/TextAppearance">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="AppImageViewIcon" parent="">
        <item name="tint">@color/icon_norm</item>
    </style>

    <style name="AppFormEditText">
        <item name="colorControlNormal">#eaecf1</item>
    </style>

    <style name="AppChipPicker" parent="@style/Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAlignment">center</item>
        <item name="chipMinTouchTargetSize">1dp</item>
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="chipStartPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
    </style>


