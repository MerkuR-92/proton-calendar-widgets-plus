<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_custom_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/alarm_custom_field_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Caption.Strong"
        android:text="@string/event_custom_alarms_field"
        android:layout_marginStart="@dimen/spacing_page"
        android:layout_marginEnd="@dimen/spacing_page"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/alarm_custom_field_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/InputText"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/spacing_page"
        android:layout_marginEnd="@dimen/spacing_page"
        app:layout_constraintTop_toBottomOf="@+id/alarm_custom_field_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alarm_custom_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Default"
            tools:text="15"
            android:inputType="numberDecimal"
            android:paddingTop="@dimen/default_margin_text_vertical"
            android:paddingBottom="@dimen/default_margin_text_vertical"
            android:paddingStart="@dimen/default_inner_padding_start"
            android:paddingEnd="@dimen/default_inner_padding_end"/>

    </com.google.android.material.textfield.TextInputLayout>

    <RadioGroup
        android:id="@+id/alarm_custom_radio_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="@dimen/radio_button_inner_padding_start"
        android:paddingEnd="@dimen/default_inner_padding_end"
        android:paddingBottom="@dimen/spacing_page"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alarm_custom_field_layout">

        <RadioButton
            android:id="@+id/alarm_custom_1"
            style="@style/Text.Default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:text="minutes before" />

        <RadioButton
            android:id="@+id/alarm_custom_2"
            style="@style/Text.Default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:text="hours" />

        <RadioButton
            android:id="@+id/alarm_custom_3"
            style="@style/Text.Default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:text="days" />

        <RadioButton
            android:id="@+id/alarm_custom_4"
            style="@style/Text.Default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:text="weeks" />

    </RadioGroup>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alarm_custom_time_layout"
        tools:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/alarm_custom_radio_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/alarm_custom_time_separator"
            style="@style/Separator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/alarm_custom_time_icon"
            style="@style/Icon.Form"
            android:src="@drawable/ic_clock"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_custom_time"
            app:layout_constraintTop_toTopOf="@+id/alarm_custom_time"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/alarm_custom_time"
            style="@style/Text.Default.Form"
            android:text="at 09:00"
            android:layout_marginBottom="@dimen/default_margin_text_vertical_large"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <include
            android:id="@+id/alarm_custom_time_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/alarm_custom_time_separator"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>