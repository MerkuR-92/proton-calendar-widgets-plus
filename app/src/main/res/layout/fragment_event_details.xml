<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.calendar.EventDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="39dp"
        tools:layout_editor_absoluteY="175dp">

        <!--        <com.google.android.material.chip.Chip-->
        <!--            android:id="@+id/chip"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="Chip" />-->

        <TextView
            android:id="@+id/text_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="💩 Event 💩" />
        <!--       TODO SETTING TEXT-COLOR EXPLICITLY SEEMS TO FIX EMOJI OVERLAY COLOR -->


        <TextView
            android:id="@+id/text_event_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_event_all_day_pill"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/shape_background_pill"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="@string/event_all_day"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_event_recurrence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_event_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_event_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/shape_calendar_circle"
            android:drawablePadding="2dp" />

        <TextView
            android:id="@+id/text_event_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_event_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_event_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!--            style="@style/Widget.MaterialComponents.Button.Icon"-->
        <!--    app:backgroundTint="@color/my_selector" FOR DIFFERENT COlORS IN STATES    -->
        <!--

strokeWidth etc

app:rippleColor= color statelist or hex value

app:iconPadding=="0" + contentDescription => button with icon only


-->

        <!--        STYLE IS DEFINED FOR ALL MATERIAL BUTTONS IN APP THEME-->
        <Button
            android:id="@+id/button_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/delete"
            app:icon="@drawable/ic_baseline_delete_forever_24" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
