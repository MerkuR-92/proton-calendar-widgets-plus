<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/day_layout"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/all_day_layout"
        android:visibility="gone"
        tools:visibility="visible"
        android:background="@color/background_norm"
        android:elevation="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/all_day_header"
            style="@style/Text.Caption.Strong"
            android:textColor="@color/text_hint"
            android:layout_width="71dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/event_all_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/all_day_header_date"
            style="@style/Text.Headline.Small"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_width="71dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            tools:text="24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/all_day_header"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/all_day_no_events"
            style="@style/Text.Caption"
            android:textColor="@color/text_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agenda_no_events"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/all_day_header"
            android:layout_marginStart="7dp"
            android:layout_marginTop="10dp"/>

        <View
            android:id="@+id/all_day_create_event_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/all_day_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/all_day_view_separator"/>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/all_day_list_scroll_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/all_day_header"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/all_day_items_cropped_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:layout_marginTop="4dp"
                    tools:listitem="@layout/item_day_view_event_all_day"
                    tools:itemCount="2" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/all_day_items_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:listitem="@layout/item_day_view_event_all_day"
                    tools:itemCount="2" />

                <LinearLayout
                    android:id="@+id/all_day_more_items_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <ImageView
            android:id="@+id/all_day_more_collapse_button"
            style="@style/Icon.Small"
            app:tint="@color/icon_weak"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:paddingBottom="20dp"
            android:scaleType="centerInside"
            android:rotation="180"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintStart_toStartOf="@+id/all_day_header"
            app:layout_constraintEnd_toEndOf="@+id/all_day_header"
            app:layout_constraintBottom_toTopOf="@+id/all_day_view_separator"
            android:layout_marginBottom="6dp"
            app:srcCompat="@drawable/ic_chevron_down" />

        <View
            android:id="@+id/all_day_view_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separator_norm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/all_day_view_vertical_separator"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/separator_norm"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/all_day_view_separator"
            app:layout_constraintEnd_toStartOf="@+id/all_day_list_scroll_view"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/day_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:layout_weight="1">

        <me.proton.android.calendar.presentation.calendar.customView.DayView
            android:id="@+id/day_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/large_padding"
            app:dividerHeight="@dimen/small_padding"
            app:endHour="@integer/end_hour"
            app:eventMargin="0dp"
            app:halfHourDividerColor="@color/background_norm"
            app:halfHourHeight="@dimen/half_hour_height"
            app:hourDividerColor="@color/separator_norm"
            app:hourLabelMarginEnd="4dp"
            app:hourLabelWidth="@dimen/hour_label_width"
            app:hourLabelDividerOverflow="10dp"
            app:startHour="@integer/start_hour" />

    </ScrollView>

</LinearLayout>
