    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_container_view"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:navGraph="@navigation/graph_main" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/woodsmoke"
        app:headerLayout="@layout/nav_header_main">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nav_view_calendars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="96dp">

                    <TextView
                        android:id="@+id/nav_view_calendars_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Calendars"
                        android:textColor="@color/santas_gray"
                        android:textAppearance="@style/Text.Caption.Weak"
                        android:layout_marginTop="32dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/nav_view_calendars_divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/tuna"
                        android:layout_marginTop="7dp"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_calendars_title"
                        app:layout_constraintStart_toStartOf="@+id/nav_view_calendars_title"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_drawer_calendar"
                        tools:itemCount="3"
                        app:layout_constraintStart_toStartOf="@+id/nav_view_calendars_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_calendars_divider"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nav_view_disabled_calendars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/nav_view_disabled_calendars_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Disabled calendars"
                        android:textColor="@color/santas_gray"
                        android:textAppearance="@style/Text.Caption.Weak"
                        android:layout_marginTop="32dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/nav_view_disabled_calendars_divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/tuna"
                        android:layout_marginTop="7dp"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_disabled_calendars_title"
                        app:layout_constraintStart_toStartOf="@+id/nav_view_disabled_calendars_title"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_drawer_calendar"
                        tools:itemCount="1"
                        app:layout_constraintStart_toStartOf="@+id/nav_view_disabled_calendars_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_disabled_calendars_divider"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nav_view_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/nav_view_more_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="More"
                        android:textColor="@color/santas_gray"
                        android:textAppearance="@style/Text.Caption.Weak"
                        android:layout_marginTop="32dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <View
                        android:id="@+id/nav_view_more_divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/tuna"
                        android:layout_marginTop="7dp"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_more_title"
                        app:layout_constraintStart_toStartOf="@+id/nav_view_more_title"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/nav_view_more_bug_layout"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_more_divider">

                        <ImageView
                            android:id="@+id/nav_view_more_bug_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_bug"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/nav_view_more_bug_title"
                            app:layout_constraintBottom_toBottomOf="@+id/nav_view_more_bug_title"/>

                        <TextView
                            android:id="@+id/nav_view_more_bug_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Report bug"
                            android:textAppearance="@style/Text.DefaultSmall"
                            android:textColor="@color/white"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/nav_view_more_bug_icon"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/nav_view_more_bug_divider"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:background="@color/tuna"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toBottomOf="@+id/nav_view_more_bug_title"
                            app:layout_constraintStart_toStartOf="@+id/nav_view_more_bug_title"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/nav_view_more_logout_layout"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_more_bug_layout">

                        <ImageView
                            android:id="@+id/nav_view_more_logout_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_sign_out"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/nav_view_more_logout_title"
                            app:layout_constraintBottom_toBottomOf="@+id/nav_view_more_logout_title"/>

                        <TextView
                            android:id="@+id/nav_view_more_logout_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Logout"
                            android:textAppearance="@style/Text.DefaultSmall"
                            android:textColor="@color/white"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/nav_view_more_logout_icon"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/nav_view_more_logout_divider"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:background="@color/tuna"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toBottomOf="@+id/nav_view_more_logout_title"
                            app:layout_constraintStart_toStartOf="@+id/nav_view_more_logout_title"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/nav_view_more_login_layout"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/nav_view_more_logout_layout">

                        <ImageView
                            android:id="@+id/nav_view_more_login_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_sign_out"
                            android:rotation="180"
                            android:layout_marginStart="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/nav_view_more_login_title"
                            app:layout_constraintBottom_toBottomOf="@+id/nav_view_more_login_title"/>

                        <TextView
                            android:id="@+id/nav_view_more_login_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Login"
                            android:textAppearance="@style/Text.DefaultSmall"
                            android:textColor="@color/white"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/nav_view_more_login_icon"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/nav_view_more_login_divider"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:background="@color/tuna"
                            android:layout_marginTop="14dp"
                            app:layout_constraintTop_toBottomOf="@+id/nav_view_more_login_title"
                            app:layout_constraintStart_toStartOf="@+id/nav_view_more_login_title"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/nav_view_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Text.Caption.Weak"
                    android:textColor="@color/text_weak"
                    android:layout_marginTop="32dp"
                    android:layout_gravity="center_horizontal"
                    tools:text="ProtonCalendar 2.0.0 (4099)"/>

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>