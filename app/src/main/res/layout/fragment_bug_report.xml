<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/bug_report_refresh_disclaimer"
            style="@style/Text.Default.Weak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bug_report_refresh_disclaimer"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bug_report_refresh_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_refresh_disclaimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/bug_report_refresh_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_refresh"
                style="@style/Icon"
                app:tint="?attr/proton_interaction_norm"
                android:layout_marginStart="@dimen/spacing_page"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/bug_report_refresh_title"
                app:layout_constraintBottom_toBottomOf="@+id/bug_report_refresh_title"/>

            <TextView
                android:id="@+id/bug_report_refresh_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_view_refresh"
                style="@style/Text.Default"
                android:textColor="?attr/proton_interaction_norm"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bug_report_refresh_icon"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/bug_report_refresh_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/default_separator_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_refresh_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/bug_report_title"
            style="@style/Text.Default.Strong"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/bug_report_hint_title"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_refresh_separator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:nextFocusDown="@id/bug_report_description"
            android:nextFocusForward="@id/bug_report_description"/>

        <View
            android:id="@+id/bug_report_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/default_separator_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/bug_report_description"
            style="@style/Text.Default"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/bug_report_hint_description"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:gravity="top"
            android:layout_marginTop="@dimen/default_separator_margin_top"
            android:layout_marginBottom="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_separator"
            app:layout_constraintStart_toStartOf="@+id/bug_report_title"
            app:layout_constraintEnd_toEndOf="@+id/bug_report_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
