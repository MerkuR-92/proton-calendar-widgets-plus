<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/action_clickable_size"
    android:layout_height="@dimen/action_clickable_size">

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_gravity="center"
        android:layout_width="@dimen/action_background_size"
        android:layout_height="@dimen/action_background_size"
        android:background="@drawable/ripple_action_secondary_oval"
        android:tint="@color/icon_norm"
        app:srcCompat="@drawable/ic_plus"
        android:clickable="false"
        android:focusable="false"/>

    <TextView
        android:id="@+id/toolbarActionSecondaryText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:gravity="center"
        style="@style/Text.Caption.Strong"
        android:layout_gravity="center"
        tools:visibility="visible"
        tools:text="12"/>

</FrameLayout>
