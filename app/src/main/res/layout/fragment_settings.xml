<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="12dp" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_general"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_element_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/settings_general_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/settings_general_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_general_title"
            style="@style/Text.Default"
            android:layout_marginTop="@dimen/default_margin_text_vertical"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/settings_general_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_general_info"
            style="@style/Text.Caption.Weak"
            android:layout_marginBottom="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/settings_general_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/settings_general_title"
            app:layout_constraintEnd_toEndOf="@+id/settings_general_title"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/settings_general_separator"
        style="@style/Separator"
        app:layout_constraintTop_toBottomOf="@+id/settings_general"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/settings_general_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/settings_import_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/settings_import_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/import_from_google_title"
            style="@style/Text.Default"
            android:layout_marginTop="@dimen/default_margin_text_vertical"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            android:layout_marginBottom="@dimen/spacing_page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/settings_import_separator"
        style="@style/Separator"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/settings_import"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_calendars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/settings_import_separator">

        <TextView
            android:id="@+id/settings_calendars_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_calendars"
            style="@style/Text.DefaultSmall.Strong.Brand"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_calendars_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            tools:listitem="@layout/item_settings_calendar"
            tools:itemCount="3"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settings_calendars_title"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_calendars_list_add_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@+id/settings_calendars_list"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/settings_calendars_list_add_layout_press"
                layout="@layout/view_press_overlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/settings_calendars_list_add_layout_separator"/>

            <ImageView
                android:id="@+id/settings_calendars_list_add_layout_icon"
                style="@style/Icon.Form"
                app:srcCompat="@drawable/ic_proton_plus"
                app:layout_constraintBottom_toBottomOf="@+id/settings_calendars_list_add_layout_title"
                app:layout_constraintTop_toTopOf="@+id/settings_calendars_list_add_layout_title"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/settings_calendars_list_add_layout_title"
                style="@style/Text.Default"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/default_margin_text_start"
                android:layout_marginEnd="@dimen/spacing_page"
                android:layout_marginTop="@dimen/spacing_page"
                android:text="@string/add_calendar_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/settings_calendars_list_add_layout_separator"
                style="@style/Separator"
                android:visibility="invisible"
                android:layout_marginTop="@dimen/spacing_page"
                app:layout_constraintTop_toBottomOf="@+id/settings_calendars_list_add_layout_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/settings_calendars_separator"
        style="@style/Separator"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/settings_calendars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_subscribed_calendars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/settings_calendars_separator">

        <TextView
            android:id="@+id/settings_subscribed_calendars_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_subscribed_calendars"
            style="@style/Text.DefaultSmall.Strong.Brand"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_subscribed_calendars_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            tools:listitem="@layout/item_settings_calendar"
            tools:itemCount="3"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settings_subscribed_calendars_title"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
