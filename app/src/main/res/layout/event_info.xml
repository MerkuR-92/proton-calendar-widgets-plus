<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/view_calendar_bar"
        android:layout_width="6dp"
        android:layout_height="0dp"
        android:layout_marginEnd="21dp"
        android:background="@drawable/shape_calendar_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="48dp" />

    <TextView
        android:id="@+id/text_status"
        style="@style/Text.FormHeader.Super"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Cancelled"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_summary"
        style="@style/Text.Main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/text_status"
        tools:text="Business lunch with very long title because we need to check how it looks like" />

    <TextView
        android:id="@+id/text_date_time"
        style="@style/Text.FormHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/text_summary"
        tools:text="Wednesday, 12. Feb. 2020\n08:00 - 13:00" />

    <ImageView
        android:id="@+id/image_icon_recurrence"
        style="@style/Text.FormContent"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="@+id/guideline4"
        app:layout_constraintTop_toBottomOf="@+id/text_date_time"
        app:srcCompat="@drawable/ic_arrows" />

    <TextView
        android:id="@+id/text_recurrence"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_icon_recurrence"
        app:layout_constraintTop_toTopOf="@+id/image_icon_recurrence"
        tools:text="Weekly on Friday"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
