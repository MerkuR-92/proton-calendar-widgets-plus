<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_mini_calendar_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/calendar_item_height"
    android:background="@drawable/ripple_mini_calendar_day"
    >

    <View
        android:id="@+id/selected_background"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/ripple_mini_calendar_day_selected"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text"
        app:layout_constraintEnd_toEndOf="@+id/text"/>

    <TextView
        android:id="@+id/text"
        style="@style/Text.DefaultSmall.Strong"
        android:layout_marginTop="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="13" />

    <LinearLayout
        android:id="@+id/ll_calendar_dots"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center|top"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        android:showDividers="middle"
        android:divider="@drawable/divider_item_calendar_dots"
        >

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_calendar_circle_small"
            app:tint="#E6984C"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_calendar_circle_small"
            app:tint="#C3D261"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_calendar_circle_small"
            app:tint="#69A9D1"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_calendar_circle_small"
            app:tint="#72BB75"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shape_calendar_circle_small"
            app:tint="#CF5858"
            />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
