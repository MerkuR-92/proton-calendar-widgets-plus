<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/action_clickable_size"
    android:layout_height="@dimen/action_clickable_size">

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_gravity="center"
        android:layout_width="@dimen/action_background_size"
        android:layout_height="@dimen/action_background_size"
        android:background="@drawable/ripple_action_primary_oval"
        android:tint="@color/icon_inverted"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/ic_plus"
        android:clickable="false"
        android:focusable="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>
