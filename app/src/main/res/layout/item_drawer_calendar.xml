<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBox
        android:id="@+id/item_drawer_calendar_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:checked="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_drawer_calendar_title"
        app:layout_constraintBottom_toBottomOf="@+id/item_drawer_calendar_title"/>

    <TextView
        android:id="@+id/item_drawer_calendar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Reminders"
        style="@style/Text.DefaultSmall.Dark"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_drawer_calendar_checkbox"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/item_drawer_calendar_divider"
        style="@style/Separator.Dark"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/item_drawer_calendar_title"
        app:layout_constraintStart_toStartOf="@+id/item_drawer_calendar_title"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>