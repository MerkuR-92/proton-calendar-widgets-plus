<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/holidays_search_icon"
        style="@style/Icon.Form"
        app:srcCompat="@drawable/ic_proton_magnifier"
        app:layout_constraintTop_toTopOf="@id/holidays_search_input"
        app:layout_constraintBottom_toBottomOf="@id/holidays_search_input"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/holidays_search_input"
        style="@style/Text.Default"
        android:textColorHint="@color/text_hint"
        android:paddingStart="@dimen/default_margin_text_start"
        android:paddingTop="@dimen/spacing_page"
        android:paddingBottom="@dimen/spacing_page"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/add_holidays_country_search_hint"
        android:imeOptions="actionDone"
        android:inputType="textEmailAddress"
        android:scrollHorizontally="false"
        android:maxLength="255"
        android:singleLine="false"
        android:maxLines="1"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/holidays_close"/>

    <include
        android:id="@+id/holidays_close"
        layout="@layout/toolbar_action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/holidays_search_separator"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/holidays_search_clear"
        style="@style/Icon.Form"
        app:srcCompat="@drawable/ic_proton_cross"
        android:layout_marginEnd="@dimen/spacing_page"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/holidays_search_input"
        app:layout_constraintBottom_toBottomOf="@id/holidays_search_input"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/holidays_search_separator"
        style="@style/Separator"
        app:layout_constraintTop_toBottomOf="@+id/holidays_search_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>