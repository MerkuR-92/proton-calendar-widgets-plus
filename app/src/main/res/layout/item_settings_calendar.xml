<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/item_settings_calendar_press"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/item_settings_calendar_icon"
        android:src="@drawable/ic_dot"
        tools:tint="@color/brand_norm"
        android:layout_marginStart="19dp"
        style="@style/ColoredDot"
        app:layout_constraintTop_toTopOf="@+id/item_settings_calendar_title"
        app:layout_constraintBottom_toBottomOf="@+id/item_settings_calendar_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/item_settings_calendar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Test 1"
        style="@style/Text.Default"
        android:layout_marginStart="@dimen/spacing_page"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toEndOf="@+id/item_settings_calendar_icon"
        app:layout_constraintEnd_toStartOf="@+id/item_settings_calendar_menu_icon"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/item_settings_calendar_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Test 1"
        style="@style/Text.DefaultSmall.Weak"
        app:layout_constraintStart_toStartOf="@+id/item_settings_calendar_title"
        app:layout_constraintEnd_toStartOf="@+id/item_settings_calendar_menu_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_settings_calendar_title"/>

    <ImageView
        android:id="@+id/item_settings_calendar_menu_icon"
        style="@style/Icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        tools:visibility="visible"
        android:src="@drawable/ic_three_dots_vertical"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="?android:selectableItemBackgroundBorderless"/>

    <LinearLayout
        android:id="@+id/item_settings_calendar_badge_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:showDividers="middle"
        android:divider="@drawable/horizontal_empty_divider"
        app:layout_constraintTop_toBottomOf="@+id/item_settings_calendar_subtitle"
        app:layout_constraintStart_toStartOf="@+id/item_settings_calendar_title" />

    <View
        android:id="@+id/item_settings_calendar_bottom_separator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/item_settings_calendar_badge_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
