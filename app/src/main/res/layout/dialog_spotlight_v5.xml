<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/dialog_spotlight_v5_banner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/welcome_header"
            app:layout_constraintBottom_toBottomOf="@id/guide_header"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.47" />

        <ImageView
            android:id="@+id/dialog_spotlight_v5_banner_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/ic_logo_background_shape"
            android:backgroundTint="@color/white"
            android:elevation="24dp"
            android:outlineProvider="background"
            app:layout_constraintTop_toTopOf="@+id/dialog_spotlight_v5_banner"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_spotlight_v5_banner"
            app:layout_constraintStart_toStartOf="@+id/dialog_spotlight_v5_banner"
            app:layout_constraintEnd_toEndOf="@+id/dialog_spotlight_v5_banner"
            app:srcCompat="@drawable/ic_logo_calendar" />

        <TextView
            android:id="@+id/dialog_spotlight_v5_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/dialog_spotlight_v5_banner"
            style="@style/Text.Headline"
            tools:text="@string/spotlight_v5_dialog_rebranding_title"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_large"/>

        <TextView
            android:id="@+id/dialog_spotlight_v5_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/dialog_spotlight_v5_title"
            style="@style/Text.DefaultSmall.Weak"
            tools:text="@string/spotlight_v5_dialog_rebranding_description"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_element_small"/>

        <me.proton.core.presentation.ui.view.ProtonButton
            android:id="@+id/dialog_spotlight_v5_read_more_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/dialog_spotlight_v5_description"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_gravity="center_horizontal"
            android:text="@string/spotlight_v5_dialog_read_more_button" />

        <me.proton.core.presentation.ui.view.ProtonButton
            android:id="@+id/dialog_spotlight_v5_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/dialog_spotlight_v5_read_more_button"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/ProtonButton.Borderless.Text"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/spotlight_v5_dialog_close_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
