<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/dialog_spotlight_v5_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_spotlight_banner_light"/>

            <ImageView
                android:id="@+id/dialog_spotlight_v5_banner_logo"
                android:layout_width="96dp"
                android:layout_height="100dp"
                app:layout_constraintTop_toTopOf="@+id/dialog_spotlight_v5_banner"
                app:layout_constraintBottom_toBottomOf="@+id/dialog_spotlight_v5_banner"
                app:layout_constraintStart_toStartOf="@+id/dialog_spotlight_v5_banner"
                app:layout_constraintEnd_toEndOf="@+id/dialog_spotlight_v5_banner"
                android:src="@drawable/ic_logo_calendar"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/dialog_spotlight_v5_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Headline"
            tools:text="@string/spotlight_v5_dialog_rebranding_title"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_large"/>

        <TextView
            android:id="@+id/dialog_spotlight_v5_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.DefaultSmall.Weak"
            tools:text="@string/spotlight_v5_dialog_rebranding_description"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_element_small"/>

        <me.proton.core.presentation.ui.view.ProtonButton
            android:id="@+id/dialog_spotlight_v5_read_more_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_gravity="center_horizontal"
            android:text="@string/spotlight_v5_dialog_read_more_button" />

        <me.proton.core.presentation.ui.view.ProtonButton
            android:id="@+id/dialog_spotlight_v5_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ProtonButton.Borderless.Text"
            android:layout_marginStart="@dimen/material_dialog_inset_start"
            android:layout_marginEnd="@dimen/material_dialog_inset_end"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/spotlight_v5_dialog_close_button" />

    </LinearLayout>

</ScrollView>
