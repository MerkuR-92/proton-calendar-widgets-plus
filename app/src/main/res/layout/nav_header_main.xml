<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_background_drawer_header_user"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="48dp">

        <TextView
            android:id="@+id/nav_header_user_initials"
            android:layout_width="28dp"
            android:layout_height="28dp"
            tools:text="AS"
            android:textAppearance="@style/Text.DefaultSmall"
            android:textColor="@color/white"
            android:background="@drawable/shape_background_drawer_header_user_initials"
            android:layout_marginStart="10dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/nav_header_user_name"
            app:layout_constraintBottom_toBottomOf="@+id/nav_header_user_mail"/>

        <TextView
            android:id="@+id/nav_header_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Adam Smith"
            android:textAppearance="@style/Text.DefaultSmall"
            android:textColor="@color/white"
            android:layout_marginStart="14dp"
            android:layout_marginTop="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nav_header_user_initials"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/nav_header_user_mail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="adam@protonmail.com"
            android:textAppearance="@style/Text.Caption.Weak"
            android:textColor="@color/santas_gray"
            android:layout_marginBottom="7dp"
            app:layout_constraintTop_toBottomOf="@+id/nav_header_user_name"
            app:layout_constraintStart_toStartOf="@+id/nav_header_user_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>