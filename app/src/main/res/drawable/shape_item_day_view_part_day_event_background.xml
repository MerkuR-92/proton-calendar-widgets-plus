<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/border"
        android:left="3dp">
        <shape
            android:shape="rectangle">
            <corners android:bottomRightRadius="3dp"
                android:topRightRadius="3dp" />
            <solid android:color="@color/interaction_weak_pressed" />
        </shape>
    </item>
    <item android:id="@+id/main_surface"
        android:left="4dp"
        android:top="1dp"
        android:bottom="1dp"
        android:right="1dp"
        >
        <shape
            android:shape="rectangle">
            <solid android:color="@color/interaction_weak" />
            <corners android:bottomRightRadius="3dp"
                android:topRightRadius="3dp" />
        </shape>
    </item>
    <item android:id="@+id/side_strip"
        android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/interaction_weak_pressed" />
            <corners
                android:bottomLeftRadius="3dp"
                android:topLeftRadius="3dp"
                />
        </shape>

    </item>
</layer-list>


